# Required: Groq API key for portfolio chatbot (server-side only)
GROQ_API_KEY=your_groq_api_key_here

# Optional: comma-separated allowed origins for CORS (defaults include abdulmannan.me + localhost)
# CHAT_ALLOWED_ORIGINS=https://abdulmannan.me,https://www.abdulmannan.me,http://localhost:5173

# Chat launcher is hidden unless this is the string "true".
# VITE_ENABLE_CHAT=true

# The deployed /api/chat function returns 404 unless this is the string "true".
# It still enforces body size, message length, and per-IP rate limits when enabled.
# CHAT_ENABLED=true
